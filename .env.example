# Copie para .env e preencha antes de build ou dev local
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Auth publico controlado
VITE_ENABLE_GOOGLE_AUTH=false
VITE_GOOGLE_AUTH_CLIENT_ID=460340982485-vve8b3ilgo6b5s5hf40s4hk98ijo0k73.apps.googleusercontent.com
VITE_ENABLE_PUBLIC_SIGNUP=true
VITE_PUBLIC_SIGNUP_ENABLED=false
PUBLIC_SIGNUP_ENABLED=false
BETA_INVITE_ONLY=true

# URL pública do app (links de convite família)
VITE_APP_URL=http://localhost:5173

# Server-side only: usado por /api/product-lookup para consultar anuncio/preco real.
# Configure no ambiente do deploy (Vercel/Netlify/Supabase), nao exponha no frontend.
MERCADOLIBRE_ACCESS_TOKEN=

# Opcional: fallback com renderizacao JS quando o marketplace esconder preco no HTML.
# Exemplo suportado pelo motor: ScraperAPI com render=true.
SCRAPERAPI_KEY=

# Opcional: fonte independente para Google Shopping quando APIs dos marketplaces bloquearem.
SERPAPI_KEY=

# Server-side only: OCR tradicional antes do fallback para visão generativa.
# O endpoint deve aceitar JSON { imageBase64, mimeType } e retornar { text }.
DOCUMENT_OCR_ENDPOINT=
DOCUMENT_OCR_API_KEY=

# Server-side only: geração de embeddings (1536 dimensões).
EMBEDDINGS_ENABLED=false
EMBEDDINGS_TEST_ONLY=true
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_VERSION=v1
